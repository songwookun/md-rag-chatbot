# ============================================================
#  md-rag-chatbot 환경변수
#  이 파일을 .env.local 로 복사한 뒤 값을 채우세요:
#     cp .env.example .env.local
#  (.env.local 은 .gitignore 에 있어 커밋되지 않습니다)
# ============================================================

# --- Python 백엔드 주소 ---
# Next 의 /api/* 라우트가 여기로 요청을 넘긴다(프록시).
# 비워두면 http://localhost:8000 을 쓴다. 배포 시 백엔드 주소로 바꿀 것.
BACKEND_URL=http://localhost:8000

# ⚠ 아래 GEMINI/GITHUB/PINECONE 키는 이제 backend/.env 에서 읽는다.
#   프론트에는 더 이상 필요 없지만, 프록시 전환이 끝날 때까지 남겨둔다.

# --- 앱 이름 (프론트 상단/로그인/환영문구에 표시) ---
NEXT_PUBLIC_APP_NAME=AXBrain

# --- Gemini API (임베딩 + 답변 생성) ---
# 발급: https://aistudio.google.com/apikey   (무료 티어 있음)
GEMINI_API_KEY=

# --- 챗봇 로그인 비밀번호 (직접 정하는 값) ---
# 아무 문자열. 로그인 시 이 값을 입력합니다. (인증 서명 키로도 사용)
AUTH_PASSWORD=

# --- (선택) 인증 서명 전용 시크릿 ---
# 비워두면 AUTH_PASSWORD 를 서명 키로 재사용합니다. 보안상 별도 랜덤값 권장.
# 생성 예:  openssl rand -hex 32
AUTH_SECRET=

# --- GitHub: 노트 원본(.md)이 저장되는 "볼트" 레포 ---
# 1) 노트 저장용 repo 를 새로 만드세요 (예: my-knowledge-vault, private 가능).
#    articles / concepts / projects 폴더는 저장 시 자동 생성됩니다.
# 2) Fine-grained 토큰 발급: https://github.com/settings/personal-access-tokens
#      - Repository access : 위에서 만든 볼트 repo 만 선택
#      - Permissions > Contents : Read and write
GITHUB_TOKEN=
# 형식: 사용자명/레포명   (예: yourname/my-knowledge-vault)
GITHUB_REPO=

# --- Pinecone: 벡터 DB (의미검색) ---
# 가입: https://www.pinecone.io   (무료 티어 있음)
# 인덱스 생성 시 반드시 아래 값으로:
#      - Dimensions : 3072      (gemini-embedding-001 임베딩 차원)
#      - Metric     : cosine
PINECONE_API_KEY=
# 위에서 만든 인덱스 이름
PINECONE_INDEX=
