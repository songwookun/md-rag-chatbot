# ============================================================
#  Python 백엔드 환경변수
#     cp .env.example .env
#  루트의 .env.local 과 값은 동일. NEXT_PUBLIC_* 만 프론트 몫이라 제외.
# ============================================================

# --- Gemini API (임베딩 + 답변 생성) ---
GEMINI_API_KEY=

# --- 챗봇 로그인 비밀번호 ---
AUTH_PASSWORD=

# --- (선택) 인증 서명 전용 시크릿. 비우면 AUTH_PASSWORD 재사용 ---
#   생성 예: openssl rand -hex 32
AUTH_SECRET=

# --- GitHub 볼트 레포 ---
GITHUB_TOKEN=
GITHUB_REPO=

# --- Pinecone (Dimensions 3072 / Metric cosine) ---
PINECONE_API_KEY=
PINECONE_INDEX=

# --- 서버 설정 ---
# 개발 중이면 development, 배포 시 production (쿠키 Secure 플래그가 갈림)
APP_ENV=development
