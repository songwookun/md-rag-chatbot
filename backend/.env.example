# ============================================================
#  Python 백엔드 환경변수
#     cp .env.example .env
#  루트의 .env.local 과 값은 동일. NEXT_PUBLIC_* 만 프론트 몫이라 제외.
# ============================================================

# --- Gemini API (임베딩 + 답변 생성) ---
GEMINI_API_KEY=

# --- 챗봇 로그인 비밀번호 ---
AUTH_PASSWORD=

# --- (선택) 인증 서명 전용 시크릿. 비우면 AUTH_PASSWORD 재사용 ---
#   생성 예: openssl rand -hex 32
AUTH_SECRET=

# --- GitHub 볼트 레포 ---
GITHUB_TOKEN=
GITHUB_REPO=

# --- Pinecone (Metric cosine) ---
PINECONE_API_KEY=
PINECONE_INDEX=

# --- 임베딩 차원 ---
#   인덱스를 만들 때 정한 값과 반드시 같아야 한다. 다르면 전부 실패한다.
#   실험②(notebooks/02_sweep.ipynb): 768 이면 AUC 손실 0.001 미만에 저장량 25%.
#   현재 인덱스가 3072 로 만들어져 있어, 768 로 내리려면 새 인덱스가 필요하다.
EMBEDDING_DIMENSIONS=3072

# --- 재순위 (실험③) ---
#   기본이 cpu 인 이유는 빨라서가 아니라 흔들리지 않아서다. 실측(5쌍 x 3000자):
#     cpu  중앙 2.31초 최대 2.41초 (폭 1.0배)   mps  중앙 1.92초인데 회차에 따라 7.9초까지
#   도커/클라우드에는 mps 가 없다. 맥에서 조금 빠르게 쓰려면 mps.
RERANK_DEVICE=cpu

# --- 서버 설정 ---
# 개발 중이면 development, 배포 시 production (쿠키 Secure 플래그가 갈림)
APP_ENV=development
